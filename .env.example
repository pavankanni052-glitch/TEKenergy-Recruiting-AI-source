# Optional: enables live AI requirement extraction and screening. Demo mode remains fully usable without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Set to false only after configuring a real authenticated deployment.
TEKENERGY_DEMO_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret-in-production

# Optional provider adapters. A configured value remains untested until the integration health check succeeds.
EMAIL_PROVIDER=manual
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CALENDAR_PROVIDER=manual
SOURCING_PROVIDER=manual

# Limits enforced before external AI work or delivery attempts.
AI_MONTHLY_BUDGET_USD=25
OUTREACH_DAILY_LIMIT=50
EXTERNAL_ACTIONS_ENABLED=false
